<style>
    .login-container {
        --ink: #0d0f1a;
        --ink-soft: #1e2130;
        --paper: #faf9f6;
        --gold: #d4a547;
        --slate: #6b7280;
        --border: #eae9e4;
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        
        font-family: 'DM Sans', sans-serif;
        background-color: var(--paper);
        color: var(--ink);
        height: 100vh;
        width: 100vw;
        position: fixed;
        top: 0;
        left: 0;
        display: flex;
        z-index: 9999;
    }

    .form-side {
        flex: 0 0 45%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 4rem 12%;
        background: var(--paper);
        position: relative;
    }

    .logo {
        position: absolute;
        top: 3rem;
        left: 12%;
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
    }

    .logo-icon {
        width: 32px;
        height: 32px;
        background: var(--gold);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .logo-text {
        font-family: 'DM Serif Display', serif;
        font-size: 1.4rem;
        color: var(--ink);
        letter-spacing: -0.01em;
    }

    .auth-header { margin-bottom: 2.5rem; }
    .auth-header h1 { font-family: 'DM Serif Display', serif; font-size: 2.8rem; line-height: 1.1; margin-bottom: 0.5rem; color: var(--ink); }
    .auth-header p { color: var(--slate); font-size: 1rem; line-height: 1.6; }

    .input-group { position: relative; margin-bottom: 1.5rem; }
    
    .input-field {
        width: 100%;
        padding: 1.25rem 1rem 0.75rem;
        font-family: 'DM Sans', sans-serif;
        font-size: 1rem;
        color: var(--ink);
        background: white;
        border: 1px solid var(--border);
        border-radius: 8px;
        outline: none;
        transition: var(--transition);
    }

    .input-field:focus,
    .input-field:not(:placeholder-shown) {
        border-color: var(--gold);
        box-shadow: 0 0 0 4px rgba(212, 165, 71, 0.1);
    }

    .input-label {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--slate);
        font-size: 1rem;
        pointer-events: none;
        transition: var(--transition);
    }

    .input-field:focus ~ .input-label,
    .input-field:not(:placeholder-shown) ~ .input-label {
        top: 0.6rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--gold);
        text-transform: uppercase;
    }

    .btn-primary {
        width: 100%;
        padding: 1.1rem;
        background: var(--ink);
        color: white;
