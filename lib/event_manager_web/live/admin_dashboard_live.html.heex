<div style="max-width:1280px; margin:0 auto; padding:3rem 2rem;" class="anim-fadein">

  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2.5rem;">
    <div>
      <p style="font-size:0.75rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--gold); font-weight:600; margin:0 0 0.4rem;">Admin</p>
      <h1 style="font-family:'DM Serif Display',serif; font-size:2rem; margin:0;">Dashboard em Tempo Real</h1>
    </div>
    <button phx-click="refresh" 
            style="padding:11px 24px; background:var(--gold); color:var(--ink); border:none; border-radius:8px; font-weight:600; cursor:pointer; transition:opacity 0.2s;"
            onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
      Atualizar Agora
    </button>
  </div>

  <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:1.5rem; margin-bottom:3rem;">
    <div style="background:white; border:1px solid #eae9e4; border-radius:12px; padding:1.5rem;">
      <p style="font-size:0.8rem; text-transform:uppercase; color:var(--slate); margin:0 0 0.5rem; font-weight:600;">Total de Eventos</p>
      <div style="font-family:'DM Serif Display',serif; font-size:2.5rem; color:var(--ink);"><%= @stats.system.total_events %></div>
    </div>
    <div style="background:white; border:1px solid #eae9e4; border-radius:12px; padding:1.5rem;">
      <p style="font-size:0.8rem; text-transform:uppercase; color:var(--slate); margin:0 0 0.5rem; font-weight:600;">Participantes Totais</p>
      <div style="font-family:'DM Serif Display',serif; font-size:2.5rem; color:var(--ink);"><%= @stats.system.total_users %></div>
    </div>
    <div style="background:white; border:1px solid #eae9e4; border-radius:12px; padding:1.5rem;">
      <p style="font-size:0.8rem; text-transform:uppercase; color:var(--slate); margin:0 0 0.5rem; font-weight:600;">Inscrições</p>
      <div style="font-family:'DM Serif Display',serif; font-size:2.5rem; color:var(--cyan);"><%= @stats.system.total_registrations %></div>
    </div>
    <div style="background:white; border:1px solid #eae9e4; border-radius:12px; padding:1.5rem;">
      <p style="font-size:0.8rem; text-transform:uppercase; color:var(--slate); margin:0 0 0.5rem; font-weight:600;">Próximos Eventos</p>
      <div style="font-family:'DM Serif Display',serif; font-size:2.5rem; color:var(--gold);"><%= @stats.system.upcoming_events %></div>
    </div>
  </div>

  <div style="display:grid; grid-template-columns:1fr 1fr; gap:2rem;">
    <div style="background:white; border:1px solid #eae9e4; border-radius:12px; overflow:hidden;">
      <div style="padding:1.5rem; border-bottom:1px solid #eae9e4; background:var(--smoke);">
